# Copy to .env.local and fill in values. Never commit .env.local.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  .env.local  = everything (deployment URLs + secrets)                  │
# │  .env        = leave empty (comments only)                               │
# │  Cloud deploy = also run `npx convex env set KEY value` for backend keys │
# └─────────────────────────────────────────────────────────────────────────┘

# --- Convex deployment (auto-filled by `npx convex dev` / `npx convex login`) ---
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
#
# IMPORTANT: Only public, non-secret values belong in VITE_* variables.
# Never put API keys, webhook secrets, or JWT keys in the frontend env.

# --- Convex Auth (set on cloud via `npx convex env set`) ---
# SITE_URL=https://your-deployment.convex.site
# PUBLIC_SITE_URL=https://your-deployment.convex.site
# CONVEX_SITE_URL=https://your-deployment.convex.site
# JWT_PRIVATE_KEY=...
# JWKS={"keys":[...]}

# --- Integrations ---
# FIRECRAWL_API_KEY=fc_...
# AGENTMAIL_API_KEY=am_...
# AGENTMAIL_WEBHOOK_SECRET=whsec_...
# FIRECRAWL_WEBHOOK_SECRET=choose-a-long-random-string

# Where auto-drafted clarification emails are addressed during hackathon demo.
# Use YOUR email (the one you sign up with), not a real city agency address.
# CLARIFICATION_TEST_RECIPIENT=you@example.com
